{
  "name": "pouls-methodologie",
  "version": "0.1.0",
  "description": "Moteur public et reproductible d’agrégation des sondages utilisé par Pouls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huextrat/pouls-methodologie.git"
  },
  "files": [
    "dist",
    "METHODOLOGIE.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "yarn format:check && yarn typecheck && yarn test && yarn build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepack": "yarn build",
    "reproduce": "tsx scripts/reproduce.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "oxfmt": "^0.65.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "packageManager": "yarn@4.18.0"
}
